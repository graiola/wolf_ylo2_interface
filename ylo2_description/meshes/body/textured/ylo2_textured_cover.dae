  <library_effects>
    <effect id="covers-effect">
      <profile_COMMON>
        <newparam sid="covers_Base_Color_png-surface">
          <surface type="2D">
            <init_from>covers_Base_Color_png</init_from>
          </surface>
        </newparam>
        <newparam sid="covers_Base_Color_png-sampler">
          <sampler2D>
            <source>covers_Base_Color_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="covers_Base_Color_png-sampler" texcoord="covers-mesh-map-0"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="cover_mapping-effect">
      <profile_COMMON>
        <newparam sid="covers-surface">
          <surface type="2D">
            <init_from>covers</init_from>
          </surface>
        </newparam>
        <newparam sid="covers-sampler">
          <sampler2D>
            <source>covers-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="covers-sampler" texcoord="covers-mesh-map-0"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">0.2272727</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>

